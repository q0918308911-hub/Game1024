{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "package-analyzer",
    "version": "1.0.0",
    "author": "Cocos Creator",
    "editor": ">=3.8.3",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build": "tsc"
    },
    "description": "i18n:package-analyzer.description",
    "main": "./dist/main.js",
    "devDependencies": {
        "@cocos/creator-types": "^3.8.3",
        "@types/node": "^18.17.1"
    },
    "panels": {
        "default": {
            "title": "package-analyzer Default Panel",
            "type": "dockable",
            "main": "dist/panels/default",
            "size": {
                "min-width": 400,
                "min-height": 300,
                "width": 1024,
                "height": 600
            }
        }
    },
    "contributions": {
        "menu": [
            {
                "path": "i18n:package-analyzer.menu",
                "label": "i18n:package-analyzer.open_panel",
                "message": "open-panel"
            }
        ],
        "messages": {
            "after-reload": {
                "methods": [
                    "afterReload"
                ]
            },
            "open-panel": {
                "methods": [
                    "openPanel"
                ]
            },
            "send-to-panel": {
                "methods": [
                    "default.hello"
                ]
            }
        }
    }
}